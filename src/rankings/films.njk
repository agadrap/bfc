---
layout: layouts/rankings.njk
title: Film Rankings
permalink: /rankings/films/
---

<!-- ═══ HERO ═════════════════════════════════════════════ -->
<section class="rankings-hero">
  <div class="rankings-hero-ghost magenta">FILMS</div>
  <div class="rankings-hero-inner">
    <div class="section-tag">
      <div class="tag-line" style="background: linear-gradient(to right, var(--magenta), transparent);"></div>
      <span class="tag-text" style="color: var(--magenta2);">Leaderboard</span>
    </div>
    <h1 class="rankings-hero-title magenta">FILM RANKINGS</h1>
    <p class="rankings-hero-sub">
      Every film reviewed by the club, ranked by total Club Rating. Each score combines Anticipation, Enjoyment, and Retrospect for a maximum of 15.
    </p>
  </div>
</section>

<!-- ═══ FILTER BAR ═════════════════════════════════════── -->
<div class="filter-bar">
  <span class="filter-label">Filter</span>
  <button class="filter-btn active" data-filter="all">All</button>
  {%- for director in directors | bySeason %}
  <button class="filter-btn" data-filter="{{ director.slug }}">{{ director.lastName }}</button>
  {%- endfor %}
</div>

<!-- ═══ LEADERBOARD ═════════════════════════════════════ -->
<section class="leaderboard" id="filmLeaderboard">
{% for film in collections.filmRankings %}
  <!-- #{{ film.rank }} — {{ film.film.title }} -->
  <div class="leaderboard-row" data-director="{{ film.slug }}" data-total="{{ film.total }}" data-r="{{ film.r }}" data-e="{{ film.e }}">
    <div class="rank-num">{{ film.rank }}</div>
    <div class="row-body">
      <div class="row-director">{{ directors[film.slug].name }}</div>
      <a href="{{ film.url }}" class="row-name" style="text-decoration:none;color:inherit;">{{ film.film.title | upper }}</a>
      <div class="row-meta">
        <span class="row-meta-item">{{ film.film.year }}</span>
        <span class="row-meta-item">{{ film.film.runtime }} min</span>
        <span class="row-meta-item">{{ film.film.genres | join(" · ") }}</span>
        <span class="row-meta-item">Season {{ film.season | pad(2) }}</span>
      </div>
      <div class="score-bar-wrap">
        <div class="score-bar-fill {{ film.fillClass }}" data-width="{{ film.width }}"></div>
      </div>
      <div class="sub-scores">
        <span class="sub-score a"><span class="sub-score-dot"></span> A: {{ film.a }}</span>
        <span class="sub-score e"><span class="sub-score-dot"></span> E: {{ film.e }}</span>
        <span class="sub-score r"><span class="sub-score-dot"></span> R: {{ film.r }}</span>
      </div>
    </div>
    <div class="row-score">
      <div class="row-score-num">{{ film.total }}</div>
      <div class="row-score-max">/ 15</div>
    </div>
  </div>
{% endfor %}
</section>

<!-- ═══ TIEBREAK NOTE ══════════════════════════════════── -->
<div class="tiebreak-note">
  Ties are broken by Retrospect score first, then Enjoyment.
</div>

<script>
  // ── SCROLL REVEAL FOR LEADERBOARD ROWS
  (function() {
    const rows = document.querySelectorAll('.leaderboard-row');
    if (!rows.length) return;

    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const row = entry.target;
          const siblings = Array.from(row.parentNode.querySelectorAll('.leaderboard-row'));
          const idx = siblings.indexOf(row);
          row.style.transitionDelay = (idx * 0.12) + 's';
          row.classList.add('revealed');

          const bar = row.querySelector('.score-bar-fill');
          if (bar) {
            setTimeout(() => {
              bar.style.width = bar.dataset.width + '%';
            }, 200 + idx * 120);
          }

          io.unobserve(row);
        }
      });
    }, { threshold: 0.1 });

    rows.forEach(row => io.observe(row));
  })();

  // ── FILTER
  (function() {
    const btns = document.querySelectorAll('.filter-btn');
    const rows = document.querySelectorAll('.leaderboard-row');

    function applyFilter(filter) {
      let rank = 1;
      rows.forEach(row => {
        const dir = row.dataset.director;
        if (filter === 'all' || dir === filter) {
          row.style.display = '';
          row.querySelector('.rank-num').textContent = rank;
          rank++;
        } else {
          row.style.display = 'none';
        }
      });
    }

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyFilter(btn.dataset.filter);
      });
    });
  })();
</script>
