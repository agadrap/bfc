---
layout: layouts/rankings.njk
title: Director Rankings
permalink: /rankings/directors/
---

<!-- ═══ HERO ═════════════════════════════════════════════ -->
<section class="rankings-hero">
  <div class="rankings-hero-ghost purple">RANKED</div>
  <div class="rankings-hero-inner">
    <div class="section-tag">
      <div class="tag-line"></div>
      <span class="tag-text" style="color: var(--purple2);">Leaderboard</span>
    </div>
    <h1 class="rankings-hero-title purple">DIRECTOR RANKINGS</h1>
    <p class="rankings-hero-sub">
      Every director is scored by averaging their Club Ratings across all reviewed films. The total score (out of 15) reflects Anticipation, Enjoyment, and Retrospect — then averaged across their picks.
    </p>
  </div>
</section>

<!-- ═══ LEADERBOARD ═════════════════════════════════════ -->
<section class="leaderboard">
{% for d in collections.directorRankings %}
  {%- set meta = directors[d.slug] %}
  <!-- #{{ d.rank }} — {{ meta.lastName }} -->
  <div class="leaderboard-row" data-director="{{ d.slug }}">
    <div class="rank-num">{{ d.rank }}</div>
    <div class="row-body">
      <div class="row-name">{{ meta.name | upper }}</div>
      <div class="row-meta">
        <span class="row-meta-item">Season {{ meta.season | pad(2) }}</span>
        <span class="row-meta-item">{{ meta.nationality }}</span>
        <span class="row-meta-item">{{ d.count }} Film{% if d.count != 1 %}s{% endif %} Reviewed</span>
      </div>
      <div class="score-bar-wrap">
        <div class="score-bar-fill {{ d.fillClass }}" data-width="{{ d.width }}"></div>
      </div>
      <div class="sub-scores">
        <span class="sub-score a"><span class="sub-score-dot"></span> A: {{ d.a }}</span>
        <span class="sub-score e"><span class="sub-score-dot"></span> E: {{ d.e }}</span>
        <span class="sub-score r"><span class="sub-score-dot"></span> R: {{ d.r }}</span>
      </div>
      <a href="/directors/{{ d.slug }}/" class="row-link">View director →</a>
    </div>
    <div class="row-score">
      <div class="row-score-num">{{ d.total }}</div>
      <div class="row-score-max">/ 15</div>
    </div>
  </div>
{% endfor %}
</section>

<script>
  // ── SCROLL REVEAL FOR LEADERBOARD ROWS
  (function() {
    const rows = document.querySelectorAll('.leaderboard-row');
    if (!rows.length) return;

    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const row = entry.target;
          const siblings = Array.from(row.parentNode.children);
          const idx = siblings.indexOf(row);
          row.style.transitionDelay = (idx * 0.12) + 's';
          row.classList.add('revealed');

          // Animate score bar
          const bar = row.querySelector('.score-bar-fill');
          if (bar) {
            setTimeout(() => {
              bar.style.width = bar.dataset.width + '%';
            }, 200 + idx * 120);
          }

          io.unobserve(row);
        }
      });
    }, { threshold: 0.1 });

    rows.forEach(row => io.observe(row));
  })();
</script>
