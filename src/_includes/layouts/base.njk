<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {# Resolve director data if the page front-matter names one #}
  {% if directorSlug %}{% set dir = directors[directorSlug] %}{% endif %}

  {# Page title: reviews use film.title (properly cased), not the ALL-CAPS `title` #}
  {% set pageTitle = film.title if film else title %}
  <title>{% if pageTitle %}{{ pageTitle }} — {% endif %}{{ site.name }}</title>

  {# Canonical — matches sitemap.njk: {{ site.url }}{{ page.url }} #}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  {# Meta description: front-matter override, else per-page-type fallback #}
  {% if description %}
    {% set metaDesc = description %}
  {% elif film %}
    {% set metaDesc = dir.name + "'s " + film.title + " (" + (film.year | string) + ") — " + (film.genres | join(", ")) + ". Reviewed at " + site.name + "." %}
  {% elif dir %}
    {% set metaDesc = dir.bio | truncate(155) %}
  {% elif page.url == "/rankings/films/" %}
    {% set metaDesc = "Every film reviewed at " + site.name + ", ranked by Club Rating." %}
  {% elif page.url == "/rankings/directors/" %}
    {% set metaDesc = "Every director covered at " + site.name + ", ranked by average Club Rating." %}
  {% elif page.url == "/archive/" %}
    {% set metaDesc = "The complete archive of " + site.name + " reviews, organised by season and director." %}
  {% elif page.url == "/about/" %}
    {% set metaDesc = "About " + site.name + " — " + site.tagline + "." %}
  {% else %}
    {% set metaDesc = site.name + " — " + site.tagline + "." %}
  {% endif %}
  <meta name="description" content="{{ metaDesc }}">

  {# Open Graph + Twitter — per-film card when this is a review, otherwise
     the shared site image. Card slug is derived from film.poster's filename
     (e.g. "15_ratcatcher-1999-poster.png" → "ratcatcher-1999"). #}
  {% set ogType = "article" if film else "website" %}
  {% if film and film.poster %}
    {% set posterStem = film.poster | replace("/assets/posters/", "") | replace("-poster.png", "") %}
    {% set cardSlug = posterStem.split("_") | last %}
    {% set ogImage = "/assets/og/" + cardSlug + "-card.jpg" %}
    {% set ogImageAlt = film.title + " (" + (film.year | string) + ") — reviewed at " + site.name %}
  {% else %}
    {% set ogImage = image or "/assets/images/bayley.jpg" %}
    {% set ogImageAlt = site.name + " — " + site.tagline %}
  {% endif %}
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{{ ogType }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{% if pageTitle %}{{ pageTitle }} — {% endif %}{{ site.name }}">
  <meta property="og:description" content="{{ metaDesc }}">
  <meta property="og:image" content="{{ site.url }}{{ ogImage }}">
  {% if film and film.poster %}
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {% endif %}
  <meta property="og:image:alt" content="{{ ogImageAlt }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if pageTitle %}{{ pageTitle }} — {% endif %}{{ site.name }}">
  <meta name="twitter:description" content="{{ metaDesc }}">
  <meta name="twitter:image" content="{{ site.url }}{{ ogImage }}">
  <meta name="twitter:image:alt" content="{{ ogImageAlt }}">

  <link rel="icon" href="/assets/icons/favicon.ico" sizes="32x32">
  <link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
  <link rel="manifest" href="/assets/icons/site.webmanifest">
  <meta name="theme-color" content="#06060a">
  <link rel="stylesheet" href="/assets/css/global.css">
  {% block styles %}{% endblock %}
  <link rel="stylesheet" href="/assets/css/mobile.css">
  {% block headExtra %}{% endblock %}
</head>
<body>

<div id="cursorGlow"></div>
{% block progressBar %}{% endblock %}

{% include "partials/nav.njk" %}

{% block content %}{% endblock %}

{% include "partials/footer.njk" %}

<script src="/assets/js/global.js"></script>
{% block scripts %}{% endblock %}

<script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "7a9a7b3a7d204023a1eafd43422c17c5"}'></script>
</body>
</html>
